# Flask Configuration
FLASK_PORT=your_port
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
ENV=production

# Tuya IoT Platform Configuration
# Get these from: https://iot.tuya.com/cloud/
TUYA_ACCESS_ID=your_tuya_access_id_here
TUYA_ACCESS_SECRET=your_tuya_access_secret_here
TUYA_ENDPOINT=your_tuya_endpoint
DEVICE_ID=your_device_id_here

# Tuya Pulsar WebSocket Configuration (Real-time monitoring - ACTIVE)
TUYA_PULSAR_ENDPOINT=your_tuya_pulsar_endpoint

# Tuya Pulsar Topic: "PROD" or "TEST" (default: PROD)
# Use TEST if PROD doesn't work or if your Message Service only supports TEST
TUYA_TOPIC=TEST

# WhatsApp API Configuration
WA_API_URL=http://your-whatsapp-api-url.com/send/message
WA_API_USER=your_username
WA_API_PASSWORD=your_password
WA_GROUP_ID=your_whatsapp_group_id@g.us

# WhatsApp Alert Messages (Optional - defaults provided)
WA_MESSAGE_DOOR_OPENED='DOOR OPENED - Room accessed'
WA_MESSAGE_DOOR_CLOSED='DOOR CLOSED - Room secured'
WA_MESSAGE_SENSOR_INITIALIZED='SENSOR IS WORKING - Monitoring started'

# WhatsApp Message Parameters (Optional)
WA_IS_FORWARDED=false
WA_DURATION=0


